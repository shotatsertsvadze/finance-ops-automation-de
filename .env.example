# Copy to .env and fill in. .env is gitignored; never commit real values.

# Postgres connection. Local default (Homebrew Postgres, socket in /tmp):
DATABASE_URL=postgresql://localhost/finops
# Supabase later: use the Session Pooler string, e.g.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Test database. Create it once with: createdb finops_test
# The tests rebuild the schema in it themselves.
TEST_DATABASE_URL=postgresql://localhost/finops_test

API_PORT=4400
# Loopback by default. Set to 0.0.0.0 only if you really want it reachable.
# API_HOST=127.0.0.1

# --- Authentication ---------------------------------------------------
# Comma-separated origins allowed to call the API with credentials. Empty
# means same-origin only, which is what the Vite dev proxy gives you.
# CORS_ORIGINS=
# SESSION_HOURS=12
# Failed sign-ins are throttled per client address, never by locking the
# account: this many per account, and this many across all accounts, within
# the window.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# LOGIN_LOCK_MINUTES=15
# Password for the seeded demo accounts. Synthetic data, local demo only.
# DEMO_PASSWORD=nordwerk-demo
# npm start (NODE_ENV=production) refuses accounts on the published demo
# password. Set to true only for a hosted demo on synthetic data.
# DEMO_MODE=false
STORAGE_DIR=./storage
# JSON log lines at or above this level: debug, info, warn, error.
# LOG_LEVEL=info
# Upper bounds on every wait for the database, in milliseconds.
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TRANSACTION_MS=30000

# Policy (demo assumptions, EUR). Leave unset for defaults.
# POLICY_AUTO_APPROVE_LIMIT=500
# POLICY_TIER_1_LIMIT=5000
# POLICY_TIER_2_LIMIT=25000
# POLICY_PO_TOLERANCE_PCT=2
# POLICY_PO_TOLERANCE_MIN=10
# POLICY_PO_REQUIRED_ABOVE=500
# POLICY_FOUR_EYES_AFTER_REVIEW=true
# Distinct people for a bank-account change; only 3 is allowed (ADR-077).
# POLICY_BANK_CHANGE_DISTINCT_ACTORS=3

# Official validation (KoSIT, ADR-078). Leave KOSIT_URL unset to skip it outside
# production; a production start requires it. `npm run kosit:fetch` then
# `npm run kosit` runs the pinned daemon on 127.0.0.1:8081.
# KOSIT_URL=http://127.0.0.1:8081
# KOSIT_TIMEOUT_MS=10000
# Java 11+ for `npm run kosit`, if `java` on the PATH is not one.
# KOSIT_JAVA=/opt/homebrew/opt/openjdk@17/bin/java
# The real-validator tests (npm run test:kosit); CI sets both.
# KOSIT_TEST_URL=http://127.0.0.1:8081
# KOSIT_TEST_REQUIRED=true

# AI explanation of why an invoice stopped (ADR-080). Off unless set to true.
# On, a reviewer can ask for a verified explanation beside the checks; the
# masked evidence is sent to Anthropic. A production start with it on and no
# key is refused. Review the provider and data processing before real data.
# AI_EXPLANATIONS=true
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-6
# AI_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS=800
# `npm run ai:eval` runs the evaluation scenarios against the real model and
# writes every answer, with latency and tokens, to ai-eval-report.json.
# AI_EVAL_RUNS=3
