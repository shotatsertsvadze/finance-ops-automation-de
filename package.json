{
  "name": "finance-ops-automation-de",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "German finance operations PoC: XRechnung intake to payment with deterministic validation, routing, approvals, audit trail and KPIs.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,green \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "dev:ui": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "user:password": "node --env-file-if-exists=.env scripts/set-password.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:reset": "node --env-file=.env scripts/reset.js",
    "db:demo": "node --env-file=.env scripts/demo-data.js",
    "demo:reset": "npm run db:reset && npm run db:migrate && npm run db:seed && npm run db:demo",
    "demo:rehearse": "npm run demo:reset && node scripts/demo-walkthrough.mjs",
    "demo:record": "npm run demo:reset && DEMO_VIDEO=1 node scripts/demo-walkthrough.mjs",
    "demo:mp4": "ffmpeg -y -i demo-video/demo.webm -c:v libx264 -pix_fmt yuv420p -crf 20 -movflags +faststart demo-video/demo.mp4",
    "test": "LOG_LEVEL=warn node --env-file=.env --test --test-concurrency=1 \"server/**/*.test.js\" \"client/**/*.test.js\" \"browser/**/*.test.js\"",
    "test:browser": "node --env-file=.env --test --test-concurrency=1 \"browser/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  }
}
